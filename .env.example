# Copy to .env.local (or run `npm run setup`, which does it with a random secret). Never commit real values.

# REQUIRED. At least 32 random characters. There is no default: the app refuses to start sessions without it.
SESSION_SECRET=

# Local SQLite file by default. For production use a libSQL / Turso URL and token.
DATABASE_URL=file:data/goldledger.db
DATABASE_AUTH_TOKEN=

# Shows the demo accounts on the sign-in page. Leave unset in real use.
DEMO_MODE=

# Optional second reader for scale and karat photos (the built-in reader works without it).
GEMINI_API_KEY=
GEMINI_MODEL=

# Set to 1 only when serving over plain http on a LAN (for example a tablet on the shop Wi-Fi).
INSECURE_COOKIES=
