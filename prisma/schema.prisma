datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  BRANCH_MANAGER
  INVENTORY_MANAGER
  ACCOUNTANT
  KARIGAR
  OLD_GOLD_STAFF
}

enum BranchType {
  SHOWROOM
  CENTRAL_VAULT
  WORKSHOP
  REFINERY
}

enum JobCardStatus {
  PENDING
  IN_PROGRESS
  PARTIALLY_RECEIVED
  COMPLETED
  OVERDUE
  CANCELLED
}

enum ReceiptItemType {
  FINISHED_JEWELLERY
  SCRAP
  FILINGS
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  REJECTED
  CANCELLED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertType {
  EXCESS_WASTAGE
  UNEXPLAINED_LOSS
  NEGATIVE_STOCK_ATTEMPT
  OVERDUE_KARIGAR_JOB
  UNRECONCILED_RECEIPT
  TRANSFER_DISCREPANCY
}

enum AlertStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum OldGoldStatus {
  QUARANTINED
  TESTED
  ACCEPTED
  EXCHANGED
  SENT_TO_REFINERY
  REJECTED
}

enum TransactionType {
  ISSUE_TO_KARIGAR
  RECEIPT_FROM_KARIGAR
  OLD_GOLD_PURCHASE
  OLD_GOLD_EXCHANGE
  TRANSFER_OUT
  TRANSFER_IN
  REFINERY_OUT
  REFINERY_IN
  STOCK_ADJUSTMENT
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(INVENTORY_MANAGER)
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  phone         String?
  isActive      Boolean   @default(true)
  karigarId     String?   @unique
  karigar       Karigar?  @relation(fields: [karigarId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdJobCards       JobCard[]         @relation("JobCardCreator")
  handledReceipts       GoldReceipt[]     @relation("ReceiptHandler")
  initiatedTransfers    StockTransfer[]   @relation("TransferInitiator")
  approvedTransfers     StockTransfer[]   @relation("TransferApprover")
  oldGoldPurchases      OldGoldPurchase[] @relation("OldGoldStaff")
  auditLogs             AuditLog[]
  assignedAlerts        WastageAlert[]    @relation("AlertReviewer")
  generatedExports      ExportRecord[]
}

model Branch {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  type        BranchType  @default(SHOWROOM)
  city        String
  address     String?
  phone       String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  locations   Location[]
  users       User[]
  jobCards    JobCard[]
}

model Location {
  id          String    @id @default(uuid())
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  code        String    @unique
  name        String
  isHolding   Boolean   @default(false) // e.g. Quarantine / Old-Gold desk holding
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  balances              InventoryBalance[]
  sourceTransactions    InventoryTransaction[] @relation("SourceLocation")
  destTransactions      InventoryTransaction[] @relation("DestLocation")
  sourceTransfers       StockTransfer[]        @relation("TransferSource")
  destTransfers         StockTransfer[]        @relation("TransferDest")
}

model JewelleryCategory {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  standardPurity      Decimal  @default(91.6) @db.Decimal(5, 2)
  defaultMaxWastagePct Decimal @default(1.00) @db.Decimal(5, 2)
  description         String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  wastageRates        KarigarWastageRate[]
  jobCards            JobCard[]
}

model Karigar {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  phone           String
  workshop        String   // Assigned primary workshop location
  isActive        Boolean  @default(true)
  joiningDate     DateTime @default(now())
  runningBalanceFine Decimal @default(0) @db.Decimal(12, 3) // In Grams
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?
  wastageRates    KarigarWastageRate[]
  jobCards        JobCard[]
  receipts        GoldReceipt[]
  alerts          WastageAlert[]
}

model KarigarWastageRate {
  id          String            @id @default(uuid())
  karigarId   String
  karigar     Karigar           @relation(fields: [karigarId], references: [id], onDelete: Cascade)
  categoryId  String
  category    JewelleryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  allowedPct  Decimal           @db.Decimal(5, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([karigarId, categoryId])
}

model JobCard {
  id                  String        @id @default(uuid())
  jobNumber           String        @unique // e.g. JOB-2026-0012
  branchId            String
  branch              Branch        @relation(fields: [branchId], references: [id])
  karigarId           String
  karigar             Karigar       @relation(fields: [karigarId], references: [id])
  categoryId          String
  category            JewelleryCategory @relation(fields: [categoryId], references: [id])
  createdById         String
  createdBy           User          @relation("JobCardCreator", fields: [createdById], references: [id])
  status              JobCardStatus @default(IN_PROGRESS)
  targetCompletionDate DateTime
  actualCompletionDate DateTime?
  agreedWastagePct    Decimal       @db.Decimal(5, 2)
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  goldIssue           GoldIssue?
  receipts            GoldReceipt[]
  alerts              WastageAlert[]
}

model GoldIssue {
  id              String   @id @default(uuid())
  jobCardId       String   @unique
  jobCard         JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  slipNumber      String   @unique // e.g. ISS-2026-0012
  sourceLocationId String
  grossWeight     Decimal  @db.Decimal(12, 3) // in Grams
  purityPct       Decimal  @db.Decimal(5, 2)  // e.g. 91.60
  fineGoldWeight  Decimal  @db.Decimal(12, 3) // Gross * Purity / 100
  issueDate       DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GoldReceipt {
  id                    String            @id @default(uuid())
  receiptNumber         String            @unique // e.g. RCP-2026-0045
  jobCardId             String
  jobCard               JobCard           @relation(fields: [jobCardId], references: [id])
  karigarId             String
  karigar               Karigar           @relation(fields: [karigarId], references: [id])
  handledById           String
  handledBy             User              @relation("ReceiptHandler", fields: [handledById], references: [id])
  destLocationId        String
  receiptDate           DateTime          @default(now())
  totalRecoveredFineGold Decimal          @db.Decimal(12, 3)
  actualWastage         Decimal           @db.Decimal(12, 3)
  allowedWastage        Decimal           @db.Decimal(12, 3)
  excessWastage         Decimal           @db.Decimal(12, 3)
  isFinalReconciliation Boolean           @default(true)
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  items                 GoldReceiptItem[]
}

model GoldReceiptItem {
  id              String          @id @default(uuid())
  receiptId       String
  receipt         GoldReceipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemType        ReceiptItemType @default(FINISHED_JEWELLERY)
  huid            String?         // Hallmarking Unique ID (6-digit alphanumeric)
  description     String
  grossWeight     Decimal         @db.Decimal(12, 3)
  purityPct       Decimal         @db.Decimal(5, 2)
  fineGoldWeight  Decimal         @db.Decimal(12, 3)
  createdAt       DateTime        @default(now())
}

model OldGoldPurchase {
  id                  String        @id @default(uuid())
  purchaseNumber      String        @unique // e.g. OGP-2026-0098
  customerName        String
  customerPhone       String?
  itemDescription     String
  grossWeight         Decimal       @db.Decimal(12, 3)
  approvedDeduction   Decimal       @default(0) @db.Decimal(12, 3)
  netEligibleWeight   Decimal       @db.Decimal(12, 3)
  testedPurityPct     Decimal       @db.Decimal(5, 2)
  fineGoldWeight      Decimal       @db.Decimal(12, 3)
  goldRatePerGram     Decimal       @db.Decimal(10, 2)
  exchangeValue       Decimal       @db.Decimal(14, 2)
  salesBillNumber     String?
  testMethodNotes     String?
  holdingLocationId   String
  status              OldGoldStatus @default(QUARANTINED)
  staffId             String
  staff               User          @relation("OldGoldStaff", fields: [staffId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  exchanges           ExchangeTransaction[]
}

model ExchangeTransaction {
  id                String          @id @default(uuid())
  exchangeNumber    String          @unique // e.g. EX-2026-0034
  oldGoldPurchaseId String
  oldGoldPurchase   OldGoldPurchase @relation(fields: [oldGoldPurchaseId], references: [id])
  billNumber        String
  creditedAmount    Decimal         @db.Decimal(14, 2)
  exchangeDate      DateTime        @default(now())
  notes             String?
  createdAt         DateTime        @default(now())
}

model InventoryTransaction {
  id                String          @id @default(uuid())
  transactionNumber String          @unique // e.g. TXN-2026-0001
  type              TransactionType
  sourceLocationId  String?
  sourceLocation    Location?       @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  destLocationId    String?
  destLocation      Location?       @relation("DestLocation", fields: [destLocationId], references: [id])
  purityPct         Decimal         @db.Decimal(5, 2)
  grossWeight       Decimal         @db.Decimal(12, 3)
  fineGoldWeight    Decimal         @db.Decimal(12, 3)
  referenceType     String          // "JOB_ISSUE", "JOB_RECEIPT", "OLD_GOLD", "TRANSFER", "REFINERY"
  referenceId       String
  performedByUserId String
  notes             String?
  timestamp         DateTime        @default(now())

  @@index([sourceLocationId])
  @@index([destLocationId])
  @@index([timestamp])
  @@index([referenceType, referenceId])
}

model InventoryBalance {
  id              String   @id @default(uuid())
  locationId      String
  location        Location @relation(fields: [locationId], references: [id])
  purityKarats    String   // e.g. "24K", "22K_916", "18K_750"
  purityPct       Decimal  @db.Decimal(5, 2)
  grossWeight     Decimal  @default(0) @db.Decimal(12, 3)
  fineGoldWeight  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt       DateTime @updatedAt

  @@unique([locationId, purityKarats])
}

model StockTransfer {
  id                  String         @id @default(uuid())
  transferNumber      String         @unique // e.g. TRF-2026-0044
  sourceLocationId    String
  sourceLocation      Location       @relation("TransferSource", fields: [sourceLocationId], references: [id])
  destLocationId      String
  destLocation        Location       @relation("TransferDest", fields: [destLocationId], references: [id])
  status              TransferStatus @default(PENDING)
  totalGrossWeight    Decimal        @db.Decimal(12, 3)
  totalFineGoldWeight Decimal        @db.Decimal(12, 3)
  initiatedByUserId   String
  initiatedByUser     User           @relation("TransferInitiator", fields: [initiatedByUserId], references: [id])
  approvedByUserId    String?
  approvedByUser      User?          @relation("TransferApprover", fields: [approvedByUserId], references: [id])
  initiatedAt         DateTime       @default(now())
  completedAt         DateTime?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  items               StockTransferItem[]
}

model StockTransferItem {
  id              String        @id @default(uuid())
  transferId      String
  transfer        StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  purityKarats    String        // "24K", "22K_916", "18K_750"
  purityPct       Decimal       @db.Decimal(5, 2)
  grossWeight     Decimal       @db.Decimal(12, 3)
  fineGoldWeight  Decimal       @db.Decimal(12, 3)
  description     String
}

model WastageAlert {
  id              String        @id @default(uuid())
  alertNumber     String        @unique // e.g. ALT-2026-0012
  severity        AlertSeverity @default(HIGH)
  alertType       AlertType
  jobCardId       String?
  jobCard         JobCard?      @relation(fields: [jobCardId], references: [id])
  karigarId       String?
  karigar         Karigar?      @relation(fields: [karigarId], references: [id])
  expectedValue   Decimal       @db.Decimal(12, 3)
  actualValue     Decimal       @db.Decimal(12, 3)
  differenceGrams Decimal       @db.Decimal(12, 3)
  status          AlertStatus   @default(OPEN)
  reviewerId      String?
  reviewer        User?         @relation("AlertReviewer", fields: [reviewerId], references: [id])
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([severity])
}

model Reconciliation {
  id              String   @id @default(uuid())
  monthYear       String   // e.g. "2026-11"
  branchId        String
  openingFineGold Decimal  @db.Decimal(12, 3)
  totalIssuedFine Decimal  @db.Decimal(12, 3)
  totalReceivedFine Decimal @db.Decimal(12, 3)
  totalWastageFine Decimal  @db.Decimal(12, 3)
  closingFineGold Decimal  @db.Decimal(12, 3)
  varianceFine    Decimal  @default(0) @db.Decimal(12, 3)
  verifiedBy      String
  notes           String?
  createdAt       DateTime @default(now())
}

model ExportRecord {
  id            String   @id @default(uuid())
  exportId      String   @unique // e.g. EXP-2026-11-0001
  exportType    String   // "CSV_STOCK", "CSV_KARIGAR", "CSV_WASTAGE", "TALLY_XML"
  dateRangeStart DateTime
  dateRangeEnd   DateTime
  recordCount   Int
  generatedById String
  generatedBy   User     @relation(fields: [generatedById], references: [id])
  createdAt     DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String   // "CREATE_ISSUE", "RECORD_RECEIPT", "RESOLVE_ALERT", "STOCK_TRANSFER", etc.
  entityType    String   // "JobCard", "GoldIssue", "GoldReceipt", "StockTransfer", "OldGoldPurchase"
  entityId      String
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  details       String   // JSON formatted summary
  ipAddress     String?
  timestamp     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
}

