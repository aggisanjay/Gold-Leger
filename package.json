    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@libsql/client": "^0.15.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.0",
    "lucide-react": "0.454.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.0",
    "tesseract.js": "^6.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
