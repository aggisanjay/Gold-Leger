{
  "name": "gold-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "Gold ledger for a jewellery workshop: issue, receipt, wastage, loss alerts, old gold, daily stock statement.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
